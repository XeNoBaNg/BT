{
  "name": "de-vote",
  "version": "1.0.0",
  "description": "De-Vote: Blockchain-based Voting DApp for SPPU BT Lab",
  "private": true,
  "scripts": {
    "compile": "truffle compile",
    "migrate": "truffle migrate --reset --network development",
